        "variant": "titleLarge"
      },
      "layout": {
        "mode": "stack",
        "paddingDp": 24
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
      "visibleInStates": [
        "hand-searching"
      ]
    },
    {
      "id": "tracking-message",
