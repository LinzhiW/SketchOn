        "role": "lightenPressed"
      },
      "error": {
        "source": "vibrant",
        "role": "error"
      },
      "alert": {
        "source": "vibrant",
        "role": "alert"
      },
      "passable": {
        "source": "vibrant",
        "role": "passable"
      },
      "interaction": {
        "source": "vibrant",
        "role": "interaction"
      },
      "dividerLine": {
        "source": "vibrant",
        "role": "dividerLine"
      }
    },
    "brandColors": {
      "ringBand": "#3A3A40",
      "ringBezel": "#B9B9C0",
      "ringScreenBase": "#0B120D",
      "handSkin": "#59605C"
    },
    "typography": {
      "title": {
        "family": "sans-serif",
        "sizeDp": 24,
        "lineHeightDp": 32,
