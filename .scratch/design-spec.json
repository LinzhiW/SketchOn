  "nodes": [
    {
      "id": "stage-root",
      "kind": "layout",
      "layout": {
        "mode": "overlay",
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ring-on-hand",
        "finger-panel",
        "hand-hint",
        "tracking-message",
        "gesture-guide",
        "control-panel"
      ]
    },
    {
      "id": "ring-on-hand",
      "kind": "domain_visual",
      "rendererKey": "ring-on-hand",
      "purpose": "The ring worn on the finger; its screen shows the active page and follows the finger's tilt",
      "assetId": "ring-model",
      "props": {
        "joint": "first segment of the chosen finger, on whichever hand is raised",
        "lostHandDelayMs": 300,
        "displayScale": 3,
        "tipEnterDeg": 25,
        "tipExitDeg": 10,
        "tipHoldMs": 80,
        "doubleClickWaitMs": 450,
        "clickQuietMs": 300,
        "tipResettleMs": 1500,
        "nextDipGapMs": 120
      },
      "parts": {
        "band": {
          "appearance": {
            "fill": "ringBand"
          }
        },
        "bezel": {
          "appearance": {
            "fill": "ringBezel"
          }
        },
        "screen": {
          "appearance": {
            "fill": "ringScreenBase"
          }
        }
      },
      "bindings": {
        "menu": "data.menu",
        "cursor": "state.menu",
        "finger": "state.finger"
      },
      "events": {
        "handFound": "enter-ring-worn",
        "handLost": "leave-ring-worn",
        "trackingDenied": "enter-tracking-unavailable",
        "tipRight": "show-next-page",
        "tipLeft": "show-previous-page",
        "airClick": "open-item",
        "airDoubleClick": "go-back"
      },
      "visibleInStates": [
        "ring-worn"
      ],
      "accessibilityLabel": "Gemtronic ring"
    },
    {
      "id": "finger-panel",
      "kind": "text",
      "content": "Tap the finger wearing the ring",
      "textStyle": {
        "typography": "title",
        "color": "labelPrimaryLight"
      },
      "layout": {
        "mode": "column",
        "gapDp": 16,
        "paddingDp": 24,
        "widthDp": 440
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
      "children": [
        "hand-picker",
        "wear-button"
      ],
      "visibleInStates": [
        "finger-choosing"
      ]
    },
    {
      "id": "hand-picker",
      "kind": "domain_visual",
      "rendererKey": "hand-picker",
      "purpose": "Choose the finger by tapping it on a hand shape; no other control can show this",
      "props": {
        "fingers": [
          "thumb",
          "index",
          "middle",
          "ring",
          "little"
        ],
        "default": "index",
        "widthDp": 392,
        "heightDp": 420
      },
      "parts": {
        "palm": {
          "appearance": {
            "fill": "handSkin",
            "radiusDp": 32
          }
        },
        "finger": {
          "appearance": {
            "fill": "handSkin",
            "radiusDp": 28
          },
          "states": {
            "selected": {
              "fill": "labelPrimaryLight"
            }
          }
        },
        "ringMark": {
          "appearance": {
            "fill": "ringScreenBase"
          }
        }
      },
      "bindings": {
        "selected": "state.finger"
      },
      "events": {
        "tapFinger": "select-finger"
      },
      "accessibilityLabel": "Hand shape for choosing a finger"
    },
    {
      "id": "wear-button",
      "kind": "spatialui",
      "component": "sui-button",
      "content": "Put on the ring",
      "events": {
        "click": "confirm-finger"
      }
    },
    {
      "id": "gesture-guide",
      "kind": "text",
      "content": "Same gestures as the real ring",
      "textStyle": {
        "typography": "title",
        "color": "labelPrimaryLight"
      },
      "layout": {
        "mode": "column",
        "gapDp": 16,
        "paddingDp": 24,
        "widthDp": 380
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
      "children": [
        "ring-mirror",
        "guide-next",
        "guide-previous",
        "guide-open",
        "guide-back",
        "guide-click",
        "change-finger-button"
      ],
      "visibleInStates": [
