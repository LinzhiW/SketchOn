        "weight": 500
      }
    },
    "spacing": {
      "small": 8,
      "regular": 16,
      "medium": 24,
      "large": 32
    }
  },
  "surfaces": [
    {
      "id": "stage-scene",
      "type": "stage_mixed",
      "defaultSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "minSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "maxSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "rootNodeId": "stage-root",
      "placement": {
        "anchor": "user hand",
        "centerPanelM": [
          0,
          1.5,
          -0.8
        ],
        "guidePanelM": [
          0.34,
          1.5,
          -0.85
        ],
        "guidePanelYawRad": -0.38,
        "controlPanelM": [
          -0.34,
          1.5,
          -0.85
        ],
        "controlPanelYawRad": 0.38
      }
    }
  ],
  "initialStateId": "finger-choosing",
  "states": [
    {
      "id": "finger-choosing",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    },
    {
      "id": "hand-searching",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    },
    {
      "id": "ring-worn",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    },
    {
      "id": "tracking-unavailable",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    }
  ],
  "transitions": [
    {
      "id": "finger-confirmed",
      "from": "finger-choosing",
      "to": "hand-searching",
      "trigger": {
        "nodeId": "wear-button",
        "event": "click"
      }
    },
    {
      "id": "hand-found",
      "from": "hand-searching",
      "to": "ring-worn",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "handFound"
      }
    },
    {
      "id": "hand-lost",
      "from": "ring-worn",
      "to": "hand-searching",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "handLost"
      }
    },
    {
      "id": "change-finger-searching",
      "from": "hand-searching",
      "to": "finger-choosing",
      "trigger": {
        "nodeId": "change-finger-button",
        "event": "click"
      }
    },
    {
      "id": "change-finger-worn",
      "from": "ring-worn",
      "to": "finger-choosing",
      "trigger": {
        "nodeId": "change-finger-button",
        "event": "click"
      }
    },
    {
      "id": "tracking-denied",
      "from": "hand-searching",
      "to": "tracking-unavailable",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "trackingDenied"
      }
    }
  ],
  "actions": [
    {
      "id": "select-finger",
      "type": "set",
      "purpose": "Choose the finger wearing the ring",
      "binding": "state.finger"
    },
    {
      "id": "confirm-finger",
      "type": "transition",
      "purpose": "Put the ring on the chosen finger",
      "transitionId": "finger-confirmed"
    },
    {
      "id": "change-finger",
      "type": "transition",
      "purpose": "Go back to the finger choice",
      "transitionId": "change-finger-worn"
    },
    {
      "id": "enter-ring-worn",
      "type": "transition",
      "purpose": "The ring appears on the hand",
      "transitionId": "hand-found"
    },
    {
      "id": "leave-ring-worn",
      "type": "transition",
      "purpose": "The ring hides when the hand is lost and keeps its page",
      "transitionId": "hand-lost"
    },
    {
      "id": "enter-tracking-unavailable",
      "type": "transition",
      "purpose": "Explain that hand data cannot be read",
      "transitionId": "tracking-denied"
    },
    {
      "id": "show-next-page",
      "type": "increment",
      "purpose": "Tip right: next item at this menu level, as on the ring",
      "binding": "state.menu.index",
      "value": 1
    },
    {
      "id": "show-previous-page",
      "type": "increment",
      "purpose": "Tip left: previous item at this menu level, as on the ring",
      "binding": "state.menu.index",
      "value": -1
    },
    {
      "id": "open-item",
      "type": "custom",
      "purpose": "One click in the air: open the item, as on the ring",
      "binding": "state.menu"
    },
    {
      "id": "go-back",
      "type": "custom",
      "purpose": "Two clicks in the air: go back a level, as on the ring",
      "binding": "state.menu"
    },
    {
      "id": "button-next",
      "type": "increment",
      "purpose": "Right arrow: same as tipping right",
      "binding": "state.menu.index",
      "value": 1
    },
    {
      "id": "button-previous",
      "type": "increment",
      "purpose": "Left arrow: same as tipping left",
      "binding": "state.menu.index",
      "value": -1
    },
    {
      "id": "button-confirm",
      "type": "custom",
      "purpose": "Confirm button: same as one click in the air",
      "binding": "state.menu"
    },
    {
      "id": "button-back",
      "type": "custom",
      "purpose": "Back button: same as two clicks in the air",
      "binding": "state.menu"
    }
  ],
  "dataCases": {
    "normal": {
