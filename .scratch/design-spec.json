        "typography": "body",
        "color": "labelPrimaryLight"
      }
    },
    {
      "id": "guide-open",
      "kind": "text",
      "content": "Open: click once in the air",
      "textStyle": {
        "typography": "body",
        "color": "labelPrimaryLight"
      }
    },
    {
      "id": "guide-back",
      "kind": "text",
      "content": "Back: click twice in the air",
      "textStyle": {
        "typography": "body",
        "color": "labelPrimaryLight"
      }
    },
    {
      "id": "guide-click",
      "kind": "text",
      "content": "To click in the air, dip your hand sharply and stop.",
      "textStyle": {
        "typography": "body",
        "color": "labelPrimaryLight"
      }
    },
    {
      "id": "change-finger-button",
