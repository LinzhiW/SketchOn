{
  "schemaVersion": "1.0",
  "metadata": {
    "projectName": "Gemtronic Ring",
    "sourceMode": "intent_only",
    "revision": 3
  },
  "experience": {
    "subject": "wearing a jewelry-grade smart ring whose round screen is the gem",
    "user": "the ring's designer and people trying the ring for the first time",
    "context": "standing or seated, hand raised at about 35 cm from the eyes, real room visible",
    "singleJob": "feel the ring on your own finger and tip it to change its screen",
    "space": "full",
    "form": "stage_mixed",
    "signature": "the ring's lit screen is the only UI: tipping the finger changes it, as on the real ring"
  },
  "theme": {
    "scheme": "vibrant",
    "colorScheme": {
      "fillPrimary": {
        "source": "vibrant",
        "role": "fillPrimary"
      },
      "fillSecondary": {
        "source": "vibrant",
        "role": "fillSecondary"
      },
      "fillTertiary": {
        "source": "vibrant",
        "role": "fillTertiary"
      },
      "fillLight": {
        "source": "vibrant",
        "role": "fillLight"
      },
      "labelPrimaryLight": {
        "source": "vibrant",
        "role": "labelPrimaryLight"
      },
      "labelPrimary": {
        "source": "vibrant",
        "role": "labelPrimary"
      },
      "labelSecondary": {
        "source": "vibrant",
        "role": "labelSecondary"
      },
      "labelTertiary": {
        "source": "vibrant",
        "role": "labelTertiary"
      },
      "labelQuaternary": {
        "source": "vibrant",
        "role": "labelQuaternary"
      },
      "lightenHover": {
        "source": "vibrant",
        "role": "lightenHover"
      },
      "lightenPressed": {
        "source": "vibrant",
        "role": "lightenPressed"
      },
      "error": {
        "source": "vibrant",
        "role": "error"
      },
      "alert": {
        "source": "vibrant",
        "role": "alert"
      },
      "passable": {
        "source": "vibrant",
        "role": "passable"
      },
      "interaction": {
        "source": "vibrant",
        "role": "interaction"
      },
      "dividerLine": {
        "source": "vibrant",
        "role": "dividerLine"
      }
    },
    "brandColors": {
      "ringBand": "#3A3A40",
      "ringBezel": "#B9B9C0",
      "ringScreenBase": "#0B120D"
    },
    "typography": {
      "title": {
        "family": "sans-serif",
        "sizeDp": 24,
        "lineHeightDp": 32,
        "weight": 500
      },
      "body": {
        "family": "sans-serif",
        "sizeDp": 18,
        "lineHeightDp": 26,
        "weight": 400
      },
      "label": {
        "family": "sans-serif",
        "sizeDp": 14,
        "lineHeightDp": 20,
        "weight": 500
      }
    },
    "spacing": {
      "small": 8,
      "regular": 16,
      "medium": 24,
      "large": 32
    }
  },
  "surfaces": [
    {
      "id": "stage-scene",
      "type": "stage_mixed",
      "defaultSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "minSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "maxSize": {
        "width": 1.2,
        "height": 1.2,
        "depth": 1.2,
        "unit": "m"
      },
      "rootNodeId": "stage-root",
      "placement": {
        "anchor": "user hand",
        "hintPanelDistanceM": 0.8,
        "hintPanelHeightOffsetM": -0.1
      }
    }
  ],
  "initialStateId": "hand-searching",
  "states": [
    {
      "id": "hand-searching",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    },
    {
      "id": "ring-worn",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    },
    {
      "id": "tracking-unavailable",
      "surfaceRoots": {
        "stage-scene": "stage-root"
      }
    }
  ],
  "transitions": [
    {
      "id": "hand-found",
      "from": "hand-searching",
      "to": "ring-worn",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "handFound"
      }
    },
    {
      "id": "hand-lost",
      "from": "ring-worn",
      "to": "hand-searching",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "handLost"
      }
    },
    {
      "id": "tracking-denied",
      "from": "hand-searching",
      "to": "tracking-unavailable",
      "trigger": {
        "nodeId": "ring-on-hand",
        "event": "trackingDenied"
      }
    }
  ],
  "actions": [
    {
      "id": "show-next-page",
      "type": "increment",
      "purpose": "Tipping the finger one way shows the next screen, wrapping after the last",
      "binding": "state.activePageIndex",
      "value": 1
    },
    {
      "id": "show-previous-page",
      "type": "increment",
      "purpose": "Tipping the finger the other way shows the previous screen, wrapping before the first",
      "binding": "state.activePageIndex",
      "value": -1
    },
    {
      "id": "enter-ring-worn",
      "type": "transition",
      "purpose": "The ring appears on the hand",
      "transitionId": "hand-found"
    },
    {
      "id": "leave-ring-worn",
      "type": "transition",
      "purpose": "The ring hides when the hand is lost and keeps its page",
      "transitionId": "hand-lost"
    },
    {
      "id": "enter-tracking-unavailable",
      "type": "transition",
      "purpose": "Explain that hand data cannot be read",
      "transitionId": "tracking-denied"
    }
  ],
  "dataCases": {
    "normal": {
      "activePageIndex": 0,
      "pages": [
        {
          "id": "gem",
          "assetId": "page-gem"
        },
        {
          "id": "clock",
          "assetId": "page-clock"
        },
        {
          "id": "pet",
          "assetId": "page-pet"
        }
      ]
    },
    "fallback": {
      "activePageIndex": 0,
      "pages": [
        {
          "id": "gem",
          "assetId": "page-gem"
        }
      ]
    },
    "error": {
      "trackingAvailable": false,
      "activePageIndex": 0,
      "pages": []
    }
  },
  "nodes": [
    {
      "id": "stage-root",
      "kind": "layout",
      "layout": {
        "mode": "overlay",
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ring-on-hand",
        "hand-hint",
        "tracking-message"
      ]
    },
    {
      "id": "ring-on-hand",
      "kind": "domain_visual",
      "rendererKey": "ring-on-hand",
      "purpose": "The ring worn on the finger; its screen shows the active page and follows the finger's tilt",
      "assetId": "ring-model",
      "props": {
        "joint": "ring finger, first segment above the palm",
        "fallbackJointWhenLost": "keep last pose for 0.3 s, then hide",
        "displayScale": 1.5,
        "tiltTriggerDeg": 25,
        "tiltResetDeg": 10
      },
      "parts": {
        "band": {
          "appearance": {
            "fill": "ringBand"
          }
        },
        "bezel": {
          "appearance": {
            "fill": "ringBezel"
          }
        },
        "screen": {
          "appearance": {
            "fill": "ringScreenBase"
          }
        }
      },
      "bindings": {
        "pages": "data.pages",
        "activePageIndex": "state.activePageIndex"
      },
      "events": {
        "handFound": "enter-ring-worn",
        "handLost": "leave-ring-worn",
        "trackingDenied": "enter-tracking-unavailable",
        "tiltForward": "show-next-page",
        "tiltBack": "show-previous-page"
      },
      "visibleInStates": [
        "ring-worn"
      ],
      "accessibilityLabel": "Gemtronic ring"
    },
    {
      "id": "hand-hint",
      "kind": "spatialui",
      "component": "sui-text",
      "content": "Raise your hand to put on the ring",
      "props": {
        "variant": "titleLarge"
      },
      "layout": {
        "mode": "stack",
        "paddingDp": 24
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
      "visibleInStates": [
        "hand-searching"
      ]
    },
    {
      "id": "tracking-message",
      "kind": "spatialui",
      "component": "sui-text",
      "content": "Hand tracking is unavailable. Allow it in system settings, then reopen the app.",
      "props": {
        "variant": "bodyLarge"
      },
      "layout": {
        "mode": "stack",
        "paddingDp": 24,
        "maxWidthDp": 480
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
      "visibleInStates": [
        "tracking-unavailable"
      ]
    }
  ],
  "responsiveRules": [],
  "assets": [
    {
      "id": "ring-model",
      "kind": "model",
      "src": "ring.glb",
      "purpose": "Gemtronic ring, copied unchanged from the Aspirium website",
      "alt": "Gemtronic ring"
    },
    {
      "id": "page-gem",
      "kind": "image",
      "src": "page_gem.png",
      "purpose": "Firmware screen: dragon gem face",
      "alt": "Dragon gem"
    },
    {
      "id": "page-clock",
      "kind": "image",
      "src": "page_clock.png",
      "purpose": "Firmware screen: idle clock",
      "alt": "Clock"
    },
    {
      "id": "page-pet",
      "kind": "image",
      "src": "page_pet.png",
      "purpose": "Firmware screen: pet",
      "alt": "Pet"
    }
  ]
}