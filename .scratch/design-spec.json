      },
      "layout": {
        "mode": "stack",
        "paddingDp": 24,
        "maxWidthDp": 480
      },
      "appearance": {
        "fill": "ringScreenBase",
        "radiusDp": 24,
        "foreground": "labelPrimaryLight"
      },
