  "implementation": {
    "initialStateId": "hand-searching",
    "surfaces": {
      "stage-scene": {
        "type": "stage_mixed",
        "defaultSize": {
          "width": 1.2,
          "height": 1.2,
          "depth": 1.2,
          "unit": "m"
        },
        "minSize": {
          "width": 1.2,
          "height": 1.2,
          "depth": 1.2,
          "unit": "m"
        },
        "maxSize": {
          "width": 1.2,
          "height": 1.2,
          "depth": 1.2,
          "unit": "m"
        },
        "rootNodeId": "stage-root",
        "placement": {
          "anchor": "user hand",
          "hintPanelDistanceM": 0.8,
          "hintPanelHeightOffsetM": -0.1
        }
      }
    },
    "nodes": {
      "stage-root": {
        "kind": "layout",
        "layout": {
          "mode": "overlay",
          "align": "center",
          "justify": "center"
        },
        "children": [
          "ring-on-hand",
          "hand-hint",
          "tracking-message"
        ]
      },
      "ring-on-hand": {
        "kind": "domain_visual",
        "rendererKey": "ring-on-hand",
        "assetId": "ring-model",
        "props": {
          "joint": "ring finger, first segment above the palm",
          "fallbackJointWhenLost": "keep last pose for 0.3 s, then hide",
          "displayScale": 1.5,
          "tiltTriggerDeg": 25,
          "tiltResetDeg": 10
        },
        "bindings": {
          "pages": "data.pages",
          "activePageIndex": "state.activePageIndex"
        },
        "events": {
          "handFound": "enter-ring-worn",
          "handLost": "leave-ring-worn",
          "trackingDenied": "enter-tracking-unavailable",
          "tiltForward": "show-next-page",
          "tiltBack": "show-previous-page"
        },
        "visibleInStates": [
          "ring-worn"
        ],
        "accessibilityLabel": "Gemtronic ring"
      },
      "hand-hint": {
        "kind": "spatialui",
        "component": "sui-text",
        "content": "Raise your hand to put on the ring",
        "props": {
          "variant": "titleLarge"
        },
        "layout": {
          "mode": "stack",
          "paddingDp": 24
        },
        "appearance": {
          "fill": "ringScreenBase",
          "radiusDp": 24,
          "foreground": "labelPrimaryLight"
        },
        "visibleInStates": [
          "hand-searching"
        ]
      },
      "tracking-message": {
        "kind": "spatialui",
        "component": "sui-text",
        "content": "Hand tracking is unavailable. Allow it in system settings, then reopen the app.",
        "props": {
          "variant": "bodyLarge"
        },
        "layout": {
          "mode": "stack",
          "paddingDp": 24,
          "maxWidthDp": 480
        },
        "appearance": {
          "fill": "ringScreenBase",
          "radiusDp": 24,
          "foreground": "labelPrimaryLight"
        },
        "visibleInStates": [
          "tracking-unavailable"
        ]
      }
    },
    "states": {
      "hand-searching": {
        "surfaceRoots": {
          "stage-scene": "stage-root"
        }
      },
      "ring-worn": {
        "surfaceRoots": {
          "stage-scene": "stage-root"
        }
      },
      "tracking-unavailable": {
        "surfaceRoots": {
          "stage-scene": "stage-root"
        }
      }
    },
    "transitions": {
      "hand-found": {
        "from": "hand-searching",
        "to": "ring-worn",
        "trigger": {
          "nodeId": "ring-on-hand",
          "event": "handFound"
        }
      },
      "hand-lost": {
        "from": "ring-worn",
        "to": "hand-searching",
        "trigger": {
          "nodeId": "ring-on-hand",
          "event": "handLost"
        }
      },
      "tracking-denied": {
        "from": "hand-searching",
        "to": "tracking-unavailable",
        "trigger": {
          "nodeId": "ring-on-hand",
          "event": "trackingDenied"
        }
      }
    },
    "actions": {
      "show-next-page": {
        "type": "increment",
        "binding": "state.activePageIndex",
        "value": 1
      },
      "show-previous-page": {
        "type": "increment",
        "binding": "state.activePageIndex",
        "value": -1
      },
      "enter-ring-worn": {
        "type": "transition",
        "transitionId": "hand-found"
      },
      "leave-ring-worn": {
        "type": "transition",
        "transitionId": "hand-lost"
      },
      "enter-tracking-unavailable": {
        "type": "transition",
        "transitionId": "tracking-denied"
      }
    },
    "responsiveRules": {},
    "dataCases": [
      "error",
      "fallback",
      "normal"
    ],
    "assets": {
      "ring-model": {
        "kind": "model",
        "src": "ring.glb",
        "alt": "Gemtronic ring"
      },
      "page-gem": {
        "kind": "image",
        "src": "page_gem.png",
        "alt": "Dragon gem"
      },
      "page-clock": {
        "kind": "image",
        "src": "page_clock.png",
        "alt": "Clock"
      },
      "page-pet": {
        "kind": "image",
        "src": "page_pet.png",
        "alt": "Pet"
      }
    }
  }
