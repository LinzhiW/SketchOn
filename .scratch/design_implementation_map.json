      "ring-on-hand": {
        "kind": "domain_visual",
        "rendererKey": "ring-on-hand",
        "assetId": "ring-model",
        "props": {
          "joint": "first segment of the chosen finger, on whichever hand is raised",
          "lostHandDelayMs": 300,
          "displayScale": 3,
